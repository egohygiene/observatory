{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "visibility",
    "as_of",
    "admission",
    "owner_contract",
    "policy",
    "repositories",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.observatory.fleet-continuity/v1"
    },
    "contract_version": {
      "const": "1.0.0-alpha.1"
    },
    "visibility": {
      "const": "public"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "admission": {
      "type": "object"
    },
    "owner_contract": {
      "const": {
        "repository": "egohygiene/aether",
        "revision": "6f230affe30719f222c354c522db5c247559e47f",
        "path": "catalog/schemas/aether.repository-continuity.v1.schema.json",
        "sha256": "a725e004fe0db2bf96a968c6e3f300d37ecf8b00b9a0923be5c5f4c529655916",
        "contract": "aether.repository-continuity/v1",
        "version": "1.0.0",
        "lifecycle": "draft"
      }
    },
    "policy": {
      "const": {
        "repository": "egohygiene/hygiene",
        "revision": "a05b14f8b9e2772124f879f818e09a911e996ad8",
        "path": "catalog/repository-continuity-policy.json",
        "version": "1.0.0-alpha.1",
        "sha256": "2f694682df641f9c9741d79c7d23bca2ae5bd0d1e3aa6ca00cb31db17e0e2e2c",
        "status": "proposed",
        "mode": "observe"
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "represented_commit",
          "posture",
          "observation_freshness",
          "collection",
          "latest",
          "observations"
        ],
        "properties": {
          "repository": {
            "$ref": "#/$defs/repositoryIdentity"
          },
          "represented_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "posture": {
            "enum": [
              "absent",
              "provisional",
              "valid",
              "invalid",
              "stale-declared",
              "unverifiable",
              "exempt",
              "unsupported"
            ]
          },
          "observation_freshness": {
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "collection": {
            "enum": [
              "supplied",
              "other-revision-only",
              "unavailable"
            ]
          },
          "latest": {
            "anyOf": [
              {
                "$ref": "#/$defs/observation"
              },
              {
                "type": "null"
              }
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/observation"
            }
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.egohygiene.io/observatory/fleet-continuity.v1.schema.json",
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repository",
        "represented_commit",
        "observed_at",
        "valid_until",
        "source_url",
        "producer",
        "file",
        "structure",
        "pointer",
        "declared",
        "git",
        "live",
        "applicability",
        "observation_freshness"
      ],
      "properties": {
        "schema": {
          "const": "egohygiene.observatory.continuity-observation/v1"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "represented_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presence",
            "exact_case",
            "contract",
            "version"
          ],
          "properties": {
            "presence": {
              "enum": [
                "present",
                "absent",
                "unknown"
              ]
            },
            "exact_case": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "contract": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "structure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "error_count",
            "warning_count",
            "validator"
          ],
          "properties": {
            "status": {
              "enum": [
                "valid",
                "invalid",
                "not-run",
                "unavailable",
                "unsupported"
              ]
            },
            "error_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "warning_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "validator": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "pointer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presence",
            "managed_block_count"
          ],
          "properties": {
            "presence": {
              "enum": [
                "present",
                "absent",
                "unknown"
              ]
            },
            "managed_block_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "declared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "updated_at",
            "reviewed_at",
            "base_revision"
          ],
          "properties": {
            "status": {
              "enum": [
                "active",
                "stale",
                "provisional",
                "unknown"
              ]
            },
            "updated_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_revision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "file_commit",
            "file_commit_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "unverified",
                "unavailable"
              ]
            },
            "file_commit": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_commit_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "live": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verified_at"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "unverified",
                "unavailable"
              ]
            },
            "verified_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "exception_reference"
          ],
          "properties": {
            "status": {
              "enum": [
                "applicable",
                "exempt",
                "unknown",
                "unsupported"
              ]
            },
            "exception_reference": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "observation_freshness": {
          "enum": [
            "fresh",
            "stale"
          ]
        }
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "repository_id",
        "visibility",
        "source_url"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "visibility": {
          "const": "public"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
