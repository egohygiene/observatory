{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/observatory/repository-intelligence-fleet.v1.schema.json",
  "title": "Observatory Repository Intelligence fleet snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "snapshot_id",
    "generator",
    "observation_window",
    "coverage",
    "repositories",
    "views",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.observatory.repository-intelligence-fleet/v1"
    },
    "contract_version": {
      "const": "1.0.0-alpha.1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object"
    },
    "observation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earliest", "latest"],
      "properties": {
        "earliest": {
          "type": "string",
          "format": "date-time"
        },
        "latest": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "states"],
      "properties": {
        "repositories": {
          "type": "integer",
          "minimum": 1
        },
        "states": {
          "type": "object"
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "snapshot_id",
          "snapshot_digest",
          "represented_commit",
          "observed_at",
          "coverage"
        ],
        "properties": {
          "repository": {
            "type": "object"
          },
          "snapshot_id": {
            "type": "string"
          },
          "snapshot_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "represented_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "coverage": {
            "type": "object"
          }
        }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roadmap",
        "decisions",
        "journey",
        "now",
        "dependencies",
        "health",
        "releases",
        "work",
        "search"
      ],
      "properties": {
        "roadmap": {
          "type": "object"
        },
        "decisions": {
          "type": "object"
        },
        "journey": {
          "type": "object"
        },
        "now": {
          "type": "object"
        },
        "dependencies": {
          "type": "object"
        },
        "health": {
          "type": "object"
        },
        "releases": {
          "type": "object"
        },
        "work": {
          "type": "object"
        },
        "search": {
          "type": "object"
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
