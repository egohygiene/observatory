  "$defs": {
    "collectionDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "freshness",
        "reason",
        "observed_at"
      ],
      "properties": {
        "collection": {
          "enum": [
            "uncollected",
            "unavailable",
            "partial",
            "observed_empty",
            "observed",
            "failed",
            "not_applicable"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "reason": {
          "enum": [
            "access_denied",
            "collection_failed",
            "complete",
            "explicit_not_applicable",
            "filtered",
            "incomplete",
            "not_requested",
            "provider_unavailable",
            "truncated",
            "legacy_unspecified"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collection": {
                "const": "uncollected"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "not_requested"
                ]
              },
              "freshness": {
                "enum": [
                  "unknown"
                ]
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "access_denied",
                  "provider_unavailable",
                  "legacy_unspecified"
                ]
              },
              "freshness": {
                "enum": [
                  "unknown"
                ]
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "filtered",
                  "truncated",
                  "incomplete"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "observed_empty"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "complete"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "complete"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "collection_failed"
                ]
              },
              "freshness": {
                "enum": [
                  "unknown"
                ]
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "explicit_not_applicable"
                ]
              },
              "freshness": {
                "enum": [
                  "not_applicable"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "collectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roadmap",
        "decisions",
        "git",
        "issues",
        "pull_requests",
        "checks",
        "releases",
        "deployments",
        "history"
      ],
      "properties": {
        "roadmap": {
          "$ref": "#/$defs/collectionDomain"
        },
        "decisions": {
          "$ref": "#/$defs/collectionDomain"
        },
        "git": {
          "$ref": "#/$defs/collectionDomain"
        },
        "issues": {
          "$ref": "#/$defs/collectionDomain"
        },
        "pull_requests": {
          "$ref": "#/$defs/collectionDomain"
        },
        "checks": {
          "$ref": "#/$defs/collectionDomain"
        },
        "releases": {
          "$ref": "#/$defs/collectionDomain"
        },
        "deployments": {
          "$ref": "#/$defs/collectionDomain"
        },
        "history": {
          "$ref": "#/$defs/collectionDomain"
        }
      }
    }
  }
