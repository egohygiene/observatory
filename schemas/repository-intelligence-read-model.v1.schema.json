{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/observatory/repository-intelligence-read-model.v1.schema.json",
  "title": "Observatory Repository Intelligence repository read model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "snapshot_id",
    "repository",
    "represented_commit",
    "observed_at",
    "visibility",
    "generator",
    "upstream",
    "coverage",
    "graph",
    "views",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.observatory.repository-intelligence-read-model/v1"
    },
    "contract_version": {
      "const": "1.0.0-alpha.2"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "$ref": "#/$defs/entityReference"
    },
    "represented_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "visibility": {
      "enum": [
        "public",
        "internal",
        "private"
      ]
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_version",
        "projection_id",
        "digest"
      ],
      "properties": {
        "schema": {
          "const": "egohygiene.repository-intelligence/v1"
        },
        "contract_version": {
          "enum": [
            "1.0.0-alpha.1",
            "1.0.0-alpha.2"
          ]
        },
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "entities",
        "relationships",
        "events",
        "redactions",
        "extensions"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "views": {
      "$ref": "#/$defs/views"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "assertion": {
      "enum": [
        "authoritative",
        "inferred",
        "unknown"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_status",
        "counts",
        "freshness",
        "assertions",
        "domains"
      ],
      "properties": {
        "counts": {
          "type": "object"
        },
        "freshness": {
          "type": "object"
        },
        "assertions": {
          "type": "object"
        },
        "record_status": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "domains": {
          "$ref": "#/$defs/collectionCoverage"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "repository",
        "key",
        "title",
        "canonical_url",
        "visibility",
        "state",
        "assertion",
        "confidence",
        "freshness"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*/(\\.github|[a-z0-9][a-z0-9.-]*)$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "visibility": {
          "enum": [
            "public",
            "internal",
            "private"
          ]
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "confidence": {
          "$ref": "#/$defs/assertion"
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "not_applicable"
          ]
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "egohygiene/observatory:repository-intelligence"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roadmap",
        "decisions",
        "journey",
        "now",
        "dependencies",
        "health",
        "releases",
        "work",
        "search"
      ],
      "properties": {
        "roadmap": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roadmap"
              ],
              "properties": {
                "roadmap": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "decisions": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decisions"
              ],
              "properties": {
                "decisions": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "journey": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "history"
              ],
              "properties": {
                "history": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "now": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roadmap",
                "decisions",
                "git",
                "issues",
                "pull_requests",
                "checks",
                "releases",
                "deployments",
                "history"
              ],
              "properties": {
                "roadmap": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "decisions": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "git": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "issues": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "pull_requests": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "checks": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "releases": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "deployments": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "history": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roadmap",
                "decisions",
                "git",
                "issues",
                "pull_requests",
                "checks",
                "releases",
                "deployments",
                "history"
              ],
              "properties": {
                "roadmap": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "decisions": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "git": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "issues": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "pull_requests": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "checks": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "releases": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "deployments": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "history": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "health": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checks"
              ],
              "properties": {
                "checks": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "releases": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "releases",
                "deployments"
              ],
              "properties": {
                "releases": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "deployments": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "work": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roadmap",
                "issues",
                "pull_requests"
              ],
              "properties": {
                "roadmap": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "issues": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "pull_requests": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        },
        "search": {
          "type": "object",
          "required": [
            "collection_coverage"
          ],
          "properties": {
            "collection_coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roadmap",
                "decisions",
                "git",
                "issues",
                "pull_requests",
                "checks",
                "releases",
                "deployments",
                "history"
              ],
              "properties": {
                "roadmap": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "decisions": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "git": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "issues": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "pull_requests": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "checks": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "releases": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "deployments": {
                  "$ref": "#/$defs/collectionDomain"
                },
                "history": {
                  "$ref": "#/$defs/collectionDomain"
                }
              }
            }
          }
        }
      }
    },
    "collectionDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "freshness",
        "reason",
        "observed_at"
      ],
      "properties": {
        "collection": {
          "enum": [
            "uncollected",
            "unavailable",
            "partial",
            "observed_empty",
            "observed",
            "failed",
            "not_applicable"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "reason": {
          "enum": [
            "access_denied",
            "collection_failed",
            "complete",
            "explicit_not_applicable",
            "filtered",
            "incomplete",
            "not_requested",
            "provider_unavailable",
            "truncated",
            "legacy_unspecified"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collection": {
                "const": "uncollected"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "not_requested"
                ]
              },
              "freshness": {
                "enum": [
                  "unknown"
                ]
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "access_denied",
                  "provider_unavailable",
                  "legacy_unspecified"
                ]
              },
              "freshness": {
                "enum": [
                  "unknown"
                ]
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "filtered",
                  "truncated",
                  "incomplete"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "observed_empty"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "complete"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "complete"
                ]
              },
              "freshness": {
                "enum": [
                  "current",
                  "stale"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "collection_failed"
                ]
              },
              "freshness": {
                "enum": [
                  "unknown"
                ]
              },
              "observed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "collection": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "explicit_not_applicable"
                ]
              },
              "freshness": {
                "enum": [
                  "not_applicable"
                ]
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "collectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roadmap",
        "decisions",
        "git",
        "issues",
        "pull_requests",
        "checks",
        "releases",
        "deployments",
        "history"
      ],
      "properties": {
        "roadmap": {
          "$ref": "#/$defs/collectionDomain"
        },
        "decisions": {
          "$ref": "#/$defs/collectionDomain"
        },
        "git": {
          "$ref": "#/$defs/collectionDomain"
        },
        "issues": {
          "$ref": "#/$defs/collectionDomain"
        },
        "pull_requests": {
          "$ref": "#/$defs/collectionDomain"
        },
        "checks": {
          "$ref": "#/$defs/collectionDomain"
        },
        "releases": {
          "$ref": "#/$defs/collectionDomain"
        },
        "deployments": {
          "$ref": "#/$defs/collectionDomain"
        },
        "history": {
          "$ref": "#/$defs/collectionDomain"
        }
      }
    }
  }
}
